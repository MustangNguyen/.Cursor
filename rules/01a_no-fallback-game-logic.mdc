## ✅ Các mẫu ĐÚNG (Fail Fast Pattern)

### 1. Explicit Validation

```csharp
// ✅ ĐÚNG - Validate rõ ràng
public class GameManager : MonoBehaviour
{
    public void StartGame(GameConfig config)
    {
        // Validate ngay
        if (config == null)
            throw new System.ArgumentNullException(nameof(config));
        
        if (config.maxPlayers <= 0)
            throw new System.ArgumentException("maxPlayers must be > 0");
        
        if (config.levelData == null)
            throw new System.ArgumentException("levelData cannot be null");
        
        // Nếu tất cả valid, mới thực thi
        InitializeGame(config);
    }
}
```

### 2. Assertion (Development)

```csharp
// ✅ ĐÚNG - Assert trong development
public class InventorySlot : MonoBehaviour
{
    public void SetItem(Item item)
    {
        System.Diagnostics.Debug.Assert(item != null, "Item cannot be null");
        System.Diagnostics.Debug.Assert(item.id > 0, "Item ID must be > 0");
        
        this.item = item;
    }
}
```

### 3. Precondition Checks

```csharp
// ✅ ĐÚNG - Kiểm tra precondition
public class PlayerAttack : MonoBehaviour
{
    public void Attack(Enemy target)
    {
        // Precondition: target phải valid
        if (target == null)
            throw new System.ArgumentNullException(nameof(target));
        
        if (!target.IsAlive)
            throw new System.InvalidOperationException("Cannot attack dead enemy");
        
        if (Vector3.Distance(transform.position, target.transform.position) > attackRange)
            throw new System.InvalidOperationException("Target out of range");
        
        // Nếu tất cả precondition pass, thực thi attack
        ExecuteAttack(target);
    }
}
```

### 4. Guard Clauses

```csharp
// ✅ ĐÚNG - Guard clauses fail fast
public class LevelProgression : MonoBehaviour
{
    public void CompleteLevel(int levelId)
    {
        if (levelId <= 0)
            throw new System.ArgumentException("Level ID must be > 0");
        
        if (!IsLevelUnlocked(levelId))
            throw new System.InvalidOperationException("Level not unlocked");
        
        if (IsLevelAlreadyCompleted(levelId))
            throw new System.InvalidOperationException("Level already completed");
        
        // Tất cả guard pass, mới thực thi
        MarkLevelAsCompleted(levelId);
    }
}
```

